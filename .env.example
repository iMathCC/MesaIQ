# ============================================================
# MesaIQ — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Application
MESAIQ_APP_NAME=MesaIQ
MESAIQ_ENVIRONMENT=development
MESAIQ_LOG_LEVEL=INFO

# Database (used by the application via SQLAlchemy/asyncpg)
MESAIQ_DATABASE_URL=postgresql+asyncpg://mesaiq:local_password@localhost:5433/mesaiq

# Docker Compose PostgreSQL service variables
POSTGRES_DB=mesaiq
POSTGRES_USER=mesaiq
POSTGRES_PASSWORD=local_password
POSTGRES_PORT=5433
